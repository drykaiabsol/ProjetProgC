CC = gcc
CFLAGS = -Wall -Wpedantic -std=c11 -Wextra -g

gerer_sf_v2: bloc.o inode.o sf.o gerer_sf_v2.o
	$(CC) $(CFLAGS) bloc.o inode.o sf.o gerer_sf_v2.o -o gerer_sf_v2

bloc.o: bloc.c bloc.h
	$(CC) $(CFLAGS) -c bloc.c

inode.o: inode.c inode.h bloc.h
	$(CC) $(CFLAGS) -c inode.c

sf.o: sf.c sf.h inode.h
	$(CC) $(CFLAGS) -c sf.c

gerer_sf_v2.o: gerer_sf_v2.c sf.h
	$(CC) $(CFLAGS) -c gerer_sf_v2.c

clean:
	rm -f *.o gerer_sf_v2