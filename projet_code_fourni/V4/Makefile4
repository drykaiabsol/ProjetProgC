CC = gcc
CFLAGS = -Wall -Wpedantic -std=c11 -Wextra -g

gerer_sf_v4: bloc.o inode.o repertoire.o sf.o gerer_sf_v4.o
	$(CC) $(CFLAGS) bloc.o inode.o repertoire.o sf.o gerer_sf_v4.o -o gerer_sf_v4

bloc.o: bloc.c bloc.h
	$(CC) $(CFLAGS) -c bloc.c

inode.o: inode.c inode.h bloc.h
	$(CC) $(CFLAGS) -c inode.c

repertoire.o: repertoire.c repertoire.h inode.h
	$(CC) $(CFLAGS) -c repertoire.c

sf.o: sf.c sf.h inode.h bloc.h repertoire.h
	$(CC) $(CFLAGS) -c sf.c

gerer_sf_v4.o: gerer_sf_v4.c sf.h inode.h
	$(CC) $(CFLAGS) -c gerer_sf_v4.c

clean:
	rm -f *.o gerer_sf_v4